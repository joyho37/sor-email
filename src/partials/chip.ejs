<%
/**
 * 關鍵字方塊。用於收件人要原樣傳送給官方客服的**系統值**（報到關鍵字、學號）。
 * 刻意做得跟可複製區塊不同：這是系統帶進來的值，不是收件人要自己填的。
 *
 * locals：html
 */
%>
<tr>
  <td style="background-color:<%= bg %>;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="chip" bgcolor="<%= palette.chipBg %>">
      <tr>
        <td class="chip" style="padding:10px 18px;"><%- html %></td>
      </tr>
    </table>
  </td>
</tr>
