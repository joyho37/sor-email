<%
/**
 * 編號步驟標題。數字用彩色圓形徽章（Outlook 會變成方塊，可接受）。
 *
 * locals：n、title
 */
%>
<tr>
  <td style="background-color:<%= bg %>;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= bg %>;">
      <tr>
        <td align="center" width="28" class="step-no" style="width:28px;height:28px;"><%= n %></td>
        <td width="10" style="width:10px;background-color:<%= bg %>;">&nbsp;</td>
        <td class="h3"><%= title %></td>
      </tr>
    </table>
  </td>
</tr>
