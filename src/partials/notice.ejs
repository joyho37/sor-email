<%
/**
 * 提示區塊。邊框式，不用黃底——原文案的黃底是作者註記，不是設計。
 *
 * locals：html（區塊內容，可含行內標籤）
 */
%>
<tr>
  <td style="background-color:<%= bg %>;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="notice" bgcolor="<%= palette.cardBg %>">
      <tr>
        <td class="notice-text" style="padding:14px 18px;"><%- html %></td>
      </tr>
    </table>
  </td>
</tr>
