<%
/** 標題上方的膠囊 eyebrow。locals：text */
%>
<tr>
  <td style="background-color:<%= bg %>;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="eyebrow" bgcolor="<%= palette.eyebrowBg %>">
      <tr>
        <td class="eyebrow" style="padding:6px 14px;"><%= text %></td>
      </tr>
    </table>
  </td>
</tr>
